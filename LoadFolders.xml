<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- <li> must live inside a version group: ModLoadFolders.LoadDataFromXmlCustom
       uses each top-level element's NAME as the version key, so bare top-level
       <li> registered the compat folders under a bogus "li" version and they
       never loaded (this is why VSIE_Teaching_Toughness was missing).
       Once a <v1.6> group exists it replaces default resolution entirely, so
       "/" must be listed or the root Defs/Assemblies/Patches stop loading. -->
  <v1.6>
    <li>/</li>
    <li IfModActive="vanillaexpanded.vanillasocialinteractionsexpanded">1.6/Mods/VSIE</li>
    <li IfModActive="vanillaexpanded.skills">1.6/Mods/VSE</li>
  </v1.6>
</loadFolders>
