<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ToughnessSkillMod</AssemblyName>
    <!-- RimWorld 1.7 runs on Waylith (a CoreCLR fork): net10 + C# 14. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- AssemblyInfo.cs carries the attributes; don't let the SDK duplicate them. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- RimWorld ignores .deps.json; don't emit it into Assemblies/. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Build output lands directly in the mod's Assemblies/ folder. -->
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The "public" surface of a mod assembly is consumed only by the RimWorld
         runtime (XML Class= refs, Harmony, def/comp/GameComponent reflection) —
         it is not a real API boundary, so API-contract rules are suppressed:
         CA1707: Patch_* and vanilla-mirroring names use underscores intentionally.
         CA1515: RimWorld requires public types for reflection instantiation.
         CA1051: public fields are the mod convention; Scribe_Values.Look(ref ...)
                and direct settings access both need them.
         CA1062: engine-supplied parameters (Harmony __instance/__result, stat
                requests) are never null; validating them is noise.
         CA1724: type/namespace names are load-bearing — XML Class= attributes and
                the Harmony id reference them verbatim. -->
    <NoWarn>CA1707;CA1515;CA1051;CA1062;CA1724</NoWarn>
    <!-- Path depth: Source -> <ModDir> -> Mods -> RimWorld game root. -->
    <RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\</RimWorldDir>
    <!-- Harmony 3 ships inside the Harmony mod's own 1.7 load folder; never bundle it. -->
    <HarmonyDir>$(RimWorldDir)..\..\workshop\content\294100\2009463077\1.7\Assemblies\</HarmonyDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- UnityStubs exports the whole UnityEngine namespace; Rect/Vector2/Mathf and
         the IMGUI surface all resolve through it. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
